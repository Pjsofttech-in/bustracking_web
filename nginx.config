server {
    listen 80;
    server_name shrishahuprabodhini.in www.shrishahuprabodhini.in;

    # Redirect HTTP to HTTPS
    return 301 https://$host$request_uri;
}


server {
    listen 443 ssl http2;
    server_name shrishahuprabodhini.in www.shrishahuprabodhini.in;

    # SSL certificates
    ssl_certificate /etc/letsencrypt/live/shrishahuprabodhini.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shrishahuprabodhini.in/privkey.pem;

    # =====================================================
    # React frontend
    # =====================================================

    location /bustracking/ {
        alias /var/www/bustracking/dist/;

        try_files $uri $uri/ /bustracking/index.html;
    }

    # =====================================================
    # Spring Boot API
    # =====================================================

    location /bus-api/ {
        proxy_pass http://127.0.0.1:9090/;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # =====================================================
    # Security headers
    # =====================================================

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header Referrer-Policy strict-origin-when-cross-origin;

    # =====================================================
    # Static asset caching
    # =====================================================

    location /bustracking/assets/ {
        alias /var/www/bustracking/dist/assets/;

        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}