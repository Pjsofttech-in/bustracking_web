server {
    listen 80;
    server_name shrishahuprabodhini.in www.shrishahuprabodhini.in;

    # Redirect HTTP to HTTPS
    return 301 https://$host$request_uri;
}


server {
    listen 443 ssl;
    server_name shrishahuprabodhini.in www.shrishahuprabodhini.in;

    # =========================================================
    # SSL
    # =========================================================

    ssl_certificate /etc/letsencrypt/live/shrishahuprabodhini.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shrishahuprabodhini.in/privkey.pem;

    # =========================================================
    # REACT FRONTEND
    # URL:
    # https://shrishahuprabodhini.in/bustracking/
    # =========================================================

    location /bustracking/ {

        alias /var/www/bustracking/dist/;

        try_files $uri $uri/ /bustracking/index.html;
    }


    # =========================================================
    # REACT STATIC ASSETS
    # =========================================================

    location /bustracking/assets/ {

        alias /var/www/bustracking/dist/assets/;

        expires 1y;

        add_header Cache-Control "public, immutable";
    }


    # =========================================================
    # SPRING BOOT API
    #
    # Browser:
    # /bus-api/api/auth/login
    #
    # Spring Boot:
    # /api/auth/login
    #
    # The trailing slash in proxy_pass is IMPORTANT.
    # =========================================================

    location /bus-api/ {

        proxy_pass http://127.0.0.1:9090/;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /bus-api;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }


    # =========================================================
    # SECURITY HEADERS
    # =========================================================

    add_header X-Content-Type-Options "nosniff";
    add_header X-Frame-Options "SAMEORIGIN";
    add_header Referrer-Policy "strict-origin-when-cross-origin";


    # =========================================================
    # LOGS
    # =========================================================

    access_log /var/log/nginx/bustracking_access.log;
    error_log /var/log/nginx/bustracking_error.log;
}