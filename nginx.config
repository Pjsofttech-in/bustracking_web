# ────────────────────────────────────────────────────────────────────────────
#  shrishahuprabodhini.in
#    /bustracking/  → React SPA (static files)
#    /bus-api/      → Spring Boot (proxied, JWT-secured)
# ────────────────────────────────────────────────────────────────────────────

server {
    listen 80;
    listen [::]:80;
    server_name shrishahuprabodhini.in www.shrishahuprabodhini.in;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name shrishahuprabodhini.in www.shrishahuprabodhini.in;

    ssl_certificate     /etc/letsencrypt/live/shrishahuprabodhini.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shrishahuprabodhini.in/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # ─── 1. SPA: /bustracking/  ─────────────────────────────────────────────
    location /bustracking/ {
        alias /var/www/bustracking/dist/;
        try_files $uri $uri/ /bustracking/index.html;

        # Long cache for hashed assets
        location ~* ^/bustracking/assets/.*\.(js|css|woff2?|png|jpg|jpeg|gif|svg|ico|webp|avif|map)$ {
            alias /var/www/bustracking/dist/assets/;
            access_log off;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # Never cache index.html
        location = /bustracking/index.html {
            alias /var/www/bustracking/dist/index.html;
            add_header Cache-Control "no-store, no-cache, must-revalidate";
        }
    }

    # Redirect /bustracking  →  /bustracking/
    location = /bustracking {
        return 301 /bustracking/;
    }

    # ─── 2. API: /bus-api/  →  Spring Boot on :9090  ────────────────────────
    location /bus-api/ {
        # Trailing slash on proxy_pass strips the "/bus-api" prefix before
        # forwarding — Spring sees "/api/auth/login", "/bus", etc.
        proxy_pass http://127.0.0.1:9090/;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header Connection        "";

        proxy_connect_timeout 30s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        client_max_body_size  10m;

        # Handle preflight locally — Spring will also answer, but this shaves
        # a round-trip and prevents some browsers from caching a bad 401.
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  "$http_origin" always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin, X-Requested-With" always;
            add_header Access-Control-Max-Age       3600 always;
            add_header Content-Length 0;
            add_header Content-Type  "text/plain charset=UTF-8";
            return 204;
        }
    }

    # Health check
    location = /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }
}