# .env.production
# IMPORTANT: point this at the backend API prefix that nginx proxies to Spring Boot.
# NOT at the SPA path (/bustracking) and NOT at the SPA's public URL alone.
VITE_API_BASE_URL="https://shrishahuprabodhini.in/bus-api"

# SPA mount path — must match vite.config.js `base` and nginx alias
VITE_APP_BASE_PATH="/bustracking"